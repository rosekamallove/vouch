generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  password       String
  image          String?
  projects       Project[]
  onboardingStep Int       @default(0)
  createdAt      DateTime  @default(now())
}

model Project {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  apiKey       String        @unique @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  testimonials Testimonial[]
  logoUrl      String?
  brandColor   String?
  headline     String?
  description  String?
  customFields Json?
  createdAt    DateTime      @default(now())
}

model Testimonial {
  id                String            @id @default(cuid())
  projectId         String
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorName        String
  role              String?
  text              String
  rating            Int?
  avatarUrl         String?
  status            TestimonialStatus @default(PENDING)
  type              TestimonialType   @default(TEXT)
  videoUrl          String?
  tags              String[]
  customFieldValues Json?
  createdAt         DateTime          @default(now())
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TestimonialType {
  TEXT
  VIDEO
}
